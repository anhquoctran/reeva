@cms.layout({ title: 'Add Storage Provider' })
  <div class="max-w-3xl mx-auto space-y-8">
    <div class="flex items-center gap-2 text-sm text-gray-400">
      <a href="{{ route('cms.storage.index') }}" class="hover:text-brand-600 transition-colors">Storage Management</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Add Provider</span>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Add Storage Provider</h1>
      <p class="text-gray-500 text-sm mt-1">Provider configuration is encrypted in the database. You can activate it after saving.</p>
    </div>

    <div class="card-premium p-8">
      @form({ action: route('cms.storage.store'), method: 'POST' })
        <div class="space-y-6" x-data="{ driver: 's3' }">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-bold text-gray-500 uppercase" for="name">Provider Name</label>
              <input id="name" type="text" name="name" maxlength="100" class="input-base w-full" required />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-gray-500 uppercase" for="quotaGb">Storage Quota (GB)</label>
              <input id="quotaGb" type="number" name="quotaGb" min="0" max="1000000" step="any" value="10" class="input-base w-full" required />
            </div>
            <div class="space-y-2 md:col-span-2">
              <label class="text-xs font-bold text-gray-500 uppercase" for="driver">Storage Driver</label>
              <select id="driver" name="driver" x-model="driver" class="input-base w-full">
                <option value="local">Local filesystem</option>
                <option value="s3">AWS S3 compatible</option>
                <option value="minio">MinIO</option>
                <option value="seaweedfs">SeaweedFS</option>
                <option value="oci">OCI Object Storage</option>
                <option value="r2">Cloudflare R2</option>
              </select>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-100" x-show="driver === 'local'">
            <label class="text-xs font-bold text-gray-500 uppercase" for="root">Absolute storage path</label>
            <input id="root" type="text" name="root" placeholder="/absolute/path/to/storage" maxlength="2048" class="input-base w-full mt-2 font-mono text-sm" :required="driver === 'local'" />
            <p class="text-xs text-gray-400 mt-2">Use a persistent path available to every Reeva instance that shares the database.</p>
          </div>

          <div class="pt-6 border-t border-gray-100 space-y-5" x-show="driver !== 'local'">
            <div>
              <h2 class="text-sm font-bold text-gray-900">S3-compatible connection</h2>
              <p class="text-xs text-gray-500 mt-1">The bucket must already exist. Leave credentials blank to use the AWS credential chain where supported.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase" for="endpoint">Endpoint URL</label><input id="endpoint" type="url" name="endpoint" placeholder="https://account.r2.cloudflarestorage.com" maxlength="2048" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase" for="bucket">Bucket</label><input id="bucket" type="text" name="bucket" maxlength="255" class="input-base w-full" :required="driver !== 'local'" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase" for="region">Region</label><input id="region" type="text" name="region" value="us-east-1" maxlength="100" class="input-base w-full" /></div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="forcePathStyle">Bucket addressing</label>
                <select id="forcePathStyle" name="forcePathStyle" class="input-base w-full"><option value="auto">Automatic</option><option value="true">Path style</option><option value="false">Virtual-host style</option></select>
              </div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase" for="accessKeyId">Access key ID</label><input id="accessKeyId" type="password" name="accessKeyId" autocomplete="new-password" maxlength="512" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase" for="secretAccessKey">Secret access key</label><input id="secretAccessKey" type="password" name="secretAccessKey" autocomplete="new-password" maxlength="4096" class="input-base w-full" /></div>
              <div class="space-y-2 md:col-span-2"><label class="text-xs font-bold text-gray-500 uppercase" for="sessionToken">Session token</label><input id="sessionToken" type="password" name="sessionToken" autocomplete="new-password" maxlength="4096" class="input-base w-full" /></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Max attempts</label><input type="number" name="maxAttempts" min="1" max="10" value="3" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Connection timeout (ms)</label><input type="number" name="connectionTimeoutMs" min="1" max="120000" value="10000" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Socket timeout (ms)</label><input type="number" name="socketTimeoutMs" min="1" max="600000" value="120000" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Presigned URL lifetime (s)</label><input type="number" name="downloadUrlTtlSeconds" min="1" max="604800" value="3600" class="input-base w-full" /></div>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
            <a href="{{ route('cms.storage.index') }}" class="text-sm font-medium text-gray-500 hover:text-gray-900">Cancel</a>
            <button type="submit" class="btn-primary px-8">Add Provider</button>
          </div>
        </div>
      @end
    </div>
  </div>
@end
