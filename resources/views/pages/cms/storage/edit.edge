@cms.layout({ title: 'Configure Storage' })
  <div class="max-w-3xl mx-auto space-y-8">
    <div class="flex items-center gap-2 text-sm text-gray-400">
      <a href="{{ route('cms.storage.index') }}" class="hover:text-brand-600 transition-colors">Storage Management</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Configure Provider</span>
    </div>

    <div>
      <h1 class="text-2xl font-bold text-gray-900">Configure Storage Provider</h1>
      <p class="text-gray-500 text-sm mt-1">Changes are saved to the database and apply to new requests immediately.</p>
    </div>

    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      Changing the endpoint, bucket, or local path does not copy stored objects. Existing artifacts still use this provider. Keep their object keys available at the new location, or add a separate provider and activate it for new uploads.
    </div>

    <div class="card-premium p-8">
      @form({ action: route('cms.storage.update', { id: provider.id }), method: 'POST' })
        <div class="space-y-6" x-data="{ driver: '{{ provider.config.driver }}' }">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-bold text-gray-500 uppercase">Provider Name</label>
              <input type="text" name="name" value="{{ provider.name }}" class="input-base w-full" maxlength="100" required />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-gray-500 uppercase">Storage Quota (GB)</label>
              <input type="number" name="quotaGb" value="{{ provider.quotaGb }}" min="0" max="1000000" step="any" class="input-base w-full" required />
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold text-gray-500 uppercase">Driver</label>
              <div class="px-3 py-2 bg-gray-50 border border-gray-100 rounded-lg text-sm text-gray-500 font-mono capitalize">{{ provider.config.driver }}</div>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-100" x-show="driver === 'local'">
            <label class="text-xs font-bold text-gray-500 uppercase" for="root">Absolute storage path</label>
            <input id="root" type="text" name="root" value="{{ provider.config.root }}" class="input-base w-full mt-2 font-mono text-sm" maxlength="2048" :required="driver === 'local'" />
            <p class="text-xs text-gray-400 mt-2">Artifacts stay in the configured persistent storage volume.</p>
          </div>

          <div class="pt-6 border-t border-gray-100 space-y-5" x-show="driver !== 'local'">
            <div>
              <h2 class="text-sm font-bold text-gray-900">S3-compatible connection</h2>
              <p class="text-xs text-gray-500 mt-1">Credentials are encrypted in PostgreSQL and never sent back to this form.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="endpoint">Endpoint URL</label>
                <input id="endpoint" type="url" name="endpoint" value="{{ provider.config.endpoint }}" placeholder="https://account.r2.cloudflarestorage.com" maxlength="2048" class="input-base w-full" />
              </div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="bucket">Bucket</label>
                <input id="bucket" type="text" name="bucket" value="{{ provider.config.bucket }}" maxlength="255" class="input-base w-full" :required="driver !== 'local'" />
              </div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="region">Region</label>
                <input id="region" type="text" name="region" value="{{ provider.config.region }}" maxlength="100" class="input-base w-full" />
              </div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="forcePathStyle">Bucket addressing</label>
                <select id="forcePathStyle" name="forcePathStyle" class="input-base w-full">
                  <option value="auto" {{ provider.config.forcePathStyle === 'auto' ? 'selected' : '' }}>Automatic</option>
                  <option value="true" {{ provider.config.forcePathStyle === true ? 'selected' : '' }}>Path style</option>
                  <option value="false" {{ provider.config.forcePathStyle === false ? 'selected' : '' }}>Virtual-host style</option>
                </select>
              </div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="accessKeyId">Access key ID</label>
                <input id="accessKeyId" type="password" name="accessKeyId" autocomplete="new-password" placeholder="{{ provider.config.credentialsConfigured ? 'Configured; leave blank to keep' : 'Optional' }}" maxlength="512" class="input-base w-full" />
              </div>
              <div class="space-y-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="secretAccessKey">Secret access key</label>
                <input id="secretAccessKey" type="password" name="secretAccessKey" autocomplete="new-password" placeholder="{{ provider.config.credentialsConfigured ? 'Configured; leave blank to keep' : 'Optional' }}" maxlength="4096" class="input-base w-full" />
              </div>
              <div class="space-y-2 md:col-span-2">
                <label class="text-xs font-bold text-gray-500 uppercase" for="sessionToken">Session token</label>
                <input id="sessionToken" type="password" name="sessionToken" autocomplete="new-password" placeholder="{{ provider.config.sessionTokenConfigured ? 'Configured; leave blank to keep' : 'Optional' }}" maxlength="4096" class="input-base w-full" />
              </div>
            </div>

            <div class="space-y-3 rounded-xl bg-gray-50 p-4">
              <label class="flex items-start gap-2 text-xs text-gray-600" x-show="{{ provider.config.credentialsConfigured ? 'true' : 'false' }}">
                <input type="checkbox" name="clearCredentials" value="true" class="mt-0.5" />
                <span>Clear the stored access key, secret key, and session token.</span>
              </label>
              <label class="flex items-start gap-2 text-xs text-gray-600" x-show="{{ provider.config.sessionTokenConfigured ? 'true' : 'false' }}">
                <input type="checkbox" name="clearSessionToken" value="true" class="mt-0.5" />
                <span>Clear only the stored session token.</span>
              </label>
              <p class="text-xs text-gray-500">Leave both access key fields empty to keep current credentials. To rotate them, enter both fields.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Max attempts</label><input type="number" name="maxAttempts" min="1" max="10" value="{{ provider.config.maxAttempts }}" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Connection timeout (ms)</label><input type="number" name="connectionTimeoutMs" min="1" max="120000" value="{{ provider.config.connectionTimeoutMs }}" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Socket timeout (ms)</label><input type="number" name="socketTimeoutMs" min="1" max="600000" value="{{ provider.config.socketTimeoutMs }}" class="input-base w-full" /></div>
              <div class="space-y-2"><label class="text-xs font-bold text-gray-500 uppercase">Presigned URL lifetime (s)</label><input type="number" name="downloadUrlTtlSeconds" min="1" max="604800" value="{{ provider.config.downloadUrlTtlSeconds }}" class="input-base w-full" /></div>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
            <a href="{{ route('cms.storage.index') }}" class="text-sm font-medium text-gray-500 hover:text-gray-900">Cancel</a>
            <button type="submit" class="btn-primary px-8">Save Configuration</button>
          </div>
        </div>
      @end
    </div>
  </div>
@end
