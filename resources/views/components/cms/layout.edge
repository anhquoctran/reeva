<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {{ title || 'Reeva - Dashboard' }}
    </title>
    <meta name="csrf-token" content="{{ csrfToken }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script id="user-prefs" type="application/json">{{{ JSON.stringify({ theme: auth.user.theme || 'system', accentColor: auth.user.accentColor || 0 }) }}}</script>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans overflow-hidden">
    <div class="flex h-screen w-full"
         x-data="themeManager"
         data-theme="{{ auth.user.theme || 'system' }}"
         data-accent="{{ auth.user.accentColor || 0 }}">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-gray-100 flex flex-col shadow-sm transition-colors duration-300">
        <div class="p-6 h-16 border-b border-gray-50 flex items-center gap-3">
          <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center text-white font-bold shadow-md shadow-brand-100">R</div>
          <span class="text-xl font-bold tracking-tight text-gray-900">Reeva</span>
        </div>
        
        <nav class="flex-1 p-4 flex flex-col gap-1">
          <a href="{{ route('cms.dashboard') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url() === route('cms.dashboard') ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            Home
          </a>
          
          <a href="{{ route('cms.versions.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.versions.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 11h.01M7 15h.01M13 7h.01M13 11h.01M13 15h.01M17 7h.01M17 11h.01M17 15h.01M3 21h18M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"></path></svg>
            Versions
          </a>
          
          <a href="{{ route('cms.licenses.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.licenses.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
            Licenses
          </a>
          
          <a href="{{ route('cms.artifacts.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.artifacts.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            Artifacts
          </a>
          
          <a href="{{ route('cms.storage.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.storage.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
            Storage Providers
          </a>
          
          <a href="{{ route('cms.settings.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.settings.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path></svg>
            System Settings
          </a>
          
          <a href="{{ route('cms.users.index') }}" 
             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium {{ request.url().startsWith(route('cms.users.index')) ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            Users
          </a>
        </nav>
        
        <!-- User Section -->
        <div class="p-4 border-t border-gray-50">
          <div class="flex items-center gap-3 mb-4">
            <a href="{{ route('cms.profile.index') }}" class="flex items-center gap-3 flex-1 group p-2 rounded-xl hover:bg-gray-50 transition-all">
              <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center text-brand-700 font-bold uppercase ring-2 ring-brand-100 flex-shrink-0 group-hover:scale-105 transition-transform">
                {{ auth.user.initials }}
              </div>
              <div class="flex-1 overflow-hidden">
                <p class="text-sm font-extrabold truncate text-gray-900">{{ auth.user.fullName || 'Administrator' }}</p>
                <p class="text-[10px] text-gray-400 font-medium truncate">{{ auth.user.email }}</p>
              </div>
            </a>

            <!-- Appearance Popup Trigger -->
            <button @click="showAppearance = !showAppearance"
                    class="relative p-2 rounded-xl text-gray-400 hover:text-brand-600 hover:bg-gray-50 transition-all"
                    :class="showAppearance ? 'text-brand-600 bg-brand-50' : ''"
                    title="Appearance">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
              <span x-show="saving" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            </button>
          </div>

          <!-- Appearance Popup -->
          <div x-show="showAppearance"
               x-cloak
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 translate-y-2 scale-95"
               x-transition:enter-end="opacity-100 translate-y-0 scale-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100 translate-y-0 scale-100"
               x-transition:leave-end="opacity-0 translate-y-2 scale-95"
               @click.away="showAppearance = false"
               class="absolute bottom-20 left-4 w-56 bg-white border border-gray-100 rounded-2xl shadow-2xl shadow-gray-200/60 p-5 z-50"
               style="display:none">
            
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xs font-black text-gray-900 uppercase tracking-widest">Appearance</h3>
              <button @click="showAppearance = false" class="text-gray-300 hover:text-gray-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>

            <!-- Theme Selector -->
            <div class="mb-5">
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2.5">Theme</span>
              <div class="flex bg-gray-50 p-1 rounded-xl border border-gray-100 gap-0.5">
                <button @click="setTheme('light')"
                        :class="theme === 'light' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'"
                        class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded-lg text-[10px] font-bold transition-all">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path></svg>
                </button>
                <button @click="setTheme('system')"
                        :class="theme === 'system' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'"
                        class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded-lg text-[10px] font-bold transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </button>
                <button @click="setTheme('dark')"
                        :class="theme === 'dark' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-400 hover:text-gray-600'"
                        class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded-lg text-[10px] font-bold transition-all">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
                </button>
              </div>
            </div>

            <!-- Accent Color -->
            <div>
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2.5">Accent Color</span>
              <div class="flex items-center gap-1.5 flex-wrap">
                <template x-for="(preset, idx) in presets" :key="idx">
                  <button @click="setAccent(idx)"
                          class="accent-swatch"
                          :class="{ 'active': accentIndex === idx }"
                          :style="{ backgroundColor: preset.swatch }"
                          :title="preset.name"
                          :aria-label="'Set accent color to ' + preset.name">
                  </button>
                </template>
              </div>
            </div>
          </div>

          <form action="{{ route('session.destroy') }}" method="POST" class="block">
            {{ csrfField() }}
            <button type="submit" class="w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              Logout
            </button>
          </form>
        </div>

        <!-- Footer -->
        <div class="px-6 py-3 border-t border-gray-50 text-center">
          <p class="text-[11px] font-extrabold text-brand-600 tracking-wide">{{ appInfo.name }} <span class="text-gray-300">&copy;</span> {{ appInfo.year }}</p>
          <p class="text-[9px] font-mono font-bold text-gray-400 mt-0.5">{{ appInfo.versionString }}</p>
        </div>
      </aside>
      
      <!-- Content Area -->
      <main class="flex-1 overflow-y-auto w-full max-w-none bg-gray-50 transition-colors duration-300">
        <div class="p-8">
          @include('partials/toasts')
          {{{ await $slots.main() }}}
        </div>
      </main>
    </div>
  </body>
</html>
