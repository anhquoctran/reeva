{
  "name": "reeva",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node scripts/run_tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node ace migration:run",
    "db:seed": "node ace db:seed",
    "db:fresh": "node ace migration:fresh && node ace db:seed",
    "verify:migration-upgrade": "node scripts/verify_migration_postgres.mjs",
    "verify:production-smoke": "node scripts/verify_production_runtime.mjs",
    "verify:storage-config": "node scripts/verify_storage_provider_config.mjs && node scripts/run_tests.mjs --files=tests/unit/storage_provider_config.spec.ts",
    "benchmark:s3": "node scripts/benchmark_s3_storage.mjs",
    "benchmark:ota": "node scripts/benchmark_ota.mjs",
    "db:import": "node scripts/import_legacy_data.mjs",
    "verify:legacy-import": "node scripts/verify_legacy_import.mjs",
    "verify:dependencies": "node scripts/check_dependency_audit.mjs",
    "verify:docker-compose": "node scripts/verify_docker_compose.mjs"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/alpinejs": "^3.13.11",
    "@types/luxon": "^3.7.1",
    "@types/node": "~24.11.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.7.1",
    "alpinejs": "^3.15.8",
    "braces": "3.0.3",
    "eslint": "^10.0.2",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@vinejs/vine": "^4.3.0",
    "adonis-autoswagger": "^3.2.1",
    "edge.js": "^6.5.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.4",
    "tailwindcss": "^4.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
