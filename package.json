{
  "name": "reeva",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node ace migration:run",
    "db:seed": "node ace db:seed",
    "db:fresh": "node ace migration:fresh && node ace db:seed"
  },
  "imports": {
    "#controllers/*": {
      "types": "./app/controllers/*.ts",
      "default": "./app/controllers/*.js"
    },
    "#exceptions/*": {
      "types": "./app/exceptions/*.ts",
      "default": "./app/exceptions/*.js"
    },
    "#models/*": {
      "types": "./app/models/*.ts",
      "default": "./app/models/*.js"
    },
    "#mails/*": {
      "types": "./app/mails/*.ts",
      "default": "./app/mails/*.js"
    },
    "#services/*": {
      "types": "./app/services/*.ts",
      "default": "./app/services/*.js"
    },
    "#repositories/*": {
      "types": "./app/repositories/*.ts",
      "default": "./app/repositories/*.js"
    },
    "#listeners/*": {
      "types": "./app/listeners/*.ts",
      "default": "./app/listeners/*.js"
    },
    "#generated/*": {
      "types": "./.adonisjs/server/*.ts",
      "default": "./.adonisjs/server/*.js"
    },
    "#events/*": {
      "types": "./app/events/*.ts",
      "default": "./app/events/*.js"
    },
    "#middleware/*": {
      "types": "./app/middleware/*.ts",
      "default": "./app/middleware/*.js"
    },
    "#validators/*": {
      "types": "./app/validators/*.ts",
      "default": "./app/validators/*.js"
    },
    "#providers/*": {
      "types": "./providers/*.ts",
      "default": "./providers/*.js"
    },
    "#policies/*": {
      "types": "./app/policies/*.ts",
      "default": "./app/policies/*.js"
    },
    "#abilities/*": {
      "types": "./app/abilities/*.ts",
      "default": "./app/abilities/*.js"
    },
    "#database/*": {
      "types": "./database/*.ts",
      "default": "./database/*.js"
    },
    "#tests/*": {
      "types": "./tests/*.ts",
      "default": "./tests/*.js"
    },
    "#start/*": {
      "types": "./start/*.ts",
      "default": "./start/*.js"
    },
    "#config/*": {
      "types": "./config/*.ts",
      "default": "./config/*.js"
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/alpinejs": "^3.13.11",
    "@types/luxon": "^3.7.1",
    "@types/node": "~24.11.0",
    "@types/semver": "^7.7.1",
    "alpinejs": "^3.15.8",
    "eslint": "^10.0.2",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.2.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@vinejs/vine": "^4.3.0",
    "adonis-autoswagger": "^3.2.1",
    "better-sqlite3": "^12.6.2",
    "edge.js": "^6.5.0",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "mysql2": "^3.20.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.4",
    "tailwindcss": "^4.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "pnpm": {
    "overrides": {
      "yargs-parser": "~21.1.1"
    }
  }
}
