# Node
TZ=UTC
PORT=8888
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Optional 7-40 character hexadecimal commit ID for the CMS footer
APP_GIT_SHA=

# Session
SESSION_DRIVER=cookie

# PostgreSQL is the only supported database. DB_* is for direct starts.
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=reeva
DB_PASSWORD=
DB_PASSWORD_FILE=
DB_DATABASE=reeva
DB_SSL=false
# Optional PEM CA file for a remote PostgreSQL server. Certificates are verified.
DB_SSL_CA_PATH=
DB_STARTUP_TIMEOUT_SECONDS=30

# Docker Compose provisions PostgreSQL on a private network. It uses POSTGRES_*
# independently of direct-start DB_* settings. Keep the identity stable after init.
POSTGRES_USER=reeva
POSTGRES_DB=reeva
# Leave blank to generate and persist a random password on the first start.
# Changing it after init requires a coordinated role/secret rotation.
POSTGRES_PASSWORD=

# Keep storage selected in the CMS/database, or set STORAGE_DRIVER=s3 to make
# the S3-compatible provider below the default. Buckets must already exist.
STORAGE_DRIVER=database

# S3-compatible object storage: AWS S3, OCI, MinIO, SeaweedFS S3 gateway, R2, etc.
# Leave S3_ENDPOINT empty for AWS S3. For custom endpoints include http:// or https://.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# auto uses path-style for custom endpoints and virtual-host style for AWS S3.
S3_FORCE_PATH_STYLE=auto
S3_MAX_ATTEMPTS=3
S3_CONNECTION_TIMEOUT_MS=10000
S3_SOCKET_TIMEOUT_MS=120000
S3_DOWNLOAD_URL_TTL_SECONDS=3600

# Examples (uncomment and fill values for one service):
# MinIO:       STORAGE_DRIVER=s3, S3_ENDPOINT=http://minio:9000, S3_REGION=us-east-1, S3_FORCE_PATH_STYLE=true
# SeaweedFS:   STORAGE_DRIVER=s3, S3_ENDPOINT=http://seaweedfs:8333, S3_REGION=us-east-1, S3_FORCE_PATH_STYLE=true
# Cloudflare:  STORAGE_DRIVER=s3, S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false
# OCI path-style: STORAGE_DRIVER=s3, S3_ENDPOINT=https://<NAMESPACE>.compat.objectstorage.<REGION>.oci.customer-oci.com, S3_REGION=<REGION>, S3_FORCE_PATH_STYLE=true
# OCI virtual-host style: STORAGE_DRIVER=s3, S3_ENDPOINT=https://vhcompat.objectstorage.<REGION>.oci.customer-oci.com, S3_REGION=<REGION>, S3_FORCE_PATH_STYLE=false

# Mail
MAIL_MAILER=smtp
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# Uploads are parsed to temporary files and streamed to the configured provider.
MAX_UPLOAD_SIZE=1gb

# Required only when running the user seeder to create the initial root account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional comma-separated trusted proxy IPs/CIDRs; leave empty when directly exposed.
TRUSTED_PROXIES=
