# Node
TZ=UTC
PORT=8888
# Docker Compose publishes host port 8797; set APP_URL to its public URL.
HOST_PORT=8797
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Optional 7-40 character hexadecimal commit ID for the CMS footer
APP_GIT_SHA=

# Session
SESSION_DRIVER=cookie

# PostgreSQL is the only supported database. DB_* is for direct starts.
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=reeva
DB_PASSWORD=
DB_PASSWORD_FILE=
DB_DATABASE=reeva
DB_SSL=false
# Optional PEM CA file for a remote PostgreSQL server. Certificates are verified.
DB_SSL_CA_PATH=
DB_STARTUP_TIMEOUT_SECONDS=30

# Docker Compose provisions PostgreSQL on a private network. It uses POSTGRES_*
# independently of direct-start DB_* settings. Keep the identity stable after init.
POSTGRES_USER=reeva
POSTGRES_DB=reeva
# Leave blank to generate and persist a random password on the first start.
# Changing it after init requires a coordinated role/secret rotation.
POSTGRES_PASSWORD=

# Mail
MAIL_MAILER=smtp
# Set false to temporarily disable outbound mail (password reset emails).
MAIL_ENABLED=true
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# Uploads are parsed to temporary files and streamed to the configured provider.
MAX_UPLOAD_SIZE=1gb

# Optional for direct starts; Docker Compose supplies these via private volumes.
# Reeva has requester access only; approval credentials stay outside the app.
SIGNER_URL=
SIGNER_CA_FILE=
SIGNER_REQUESTER_TOKEN_FILE=

# Required only when running the user seeder to create the initial root account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional comma-separated trusted proxy IPs/CIDRs; leave empty when directly exposed.
TRUSTED_PROXIES=
